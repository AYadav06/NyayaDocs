# Streamlit Cloud Secrets Configuration
# In your Streamlit Cloud app dashboard: Go to App Settings -> Secrets, and paste the following:

# URL of your deployed FastAPI backend on Render (no trailing slash)
BACKEND_URL = "https://your-backend-service-name.onrender.com"

# Optional: Only needed if you plan to use local fallback execution on Streamlit
# GEMINI_API_KEY = "your-google-ai-studio-api-key"
